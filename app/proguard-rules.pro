# ---------------------------------------------------------------------------
# Spec 33 - native PTY bridge
# ---------------------------------------------------------------------------
# The C++ in libopencodepty.so resolves these symbols by name. R8 cannot see the
# call site, so it would happily rename or strip them and the terminal would fail
# at runtime with an UnsatisfiedLinkError on a release build only. Keeping them
# is what makes the native path work identically in debug and release.

-keepclasseswithmembernames class com.palash.opencodeserver.backend.runtime.pty.NativePty {
    native <methods>;
}

# The native reader thread calls these two methods by name via JNI. The class must
# not be renamed either, because the lookup goes through the object handed to nOpen.
-keepclassmembers class com.palash.opencodeserver.backend.runtime.pty.NativePty$NativeDataSink {
    public void onNativeData(byte[], boolean);
    public void onNativeExit(int);
}

# JNI method signatures are resolved by descriptor, so the names must survive.
-keepclasseswithmembernames,includedescriptorclasses class com.palash.opencodeserver.backend.runtime.pty.** {
    native <methods>;
}

# ---------------------------------------------------------------------------
# Moshi
# ---------------------------------------------------------------------------
# Adapters are generated by KSP, but Moshi looks them up reflectively by name, so
# the generated classes must survive shrinking.
-keep class com.palash.opencodeserver.backend.api.**JsonAdapter { *; }
-keepnames @com.squareup.moshi.JsonClass class com.palash.opencodeserver.backend.api.**
-keep class kotlin.Metadata { *; }